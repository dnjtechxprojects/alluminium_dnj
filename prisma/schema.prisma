generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {  
  id         String   @id @default(uuid())
  title      String
  content    String
  excerpt    String?
  slug       String   @unique
  image      String  @db.Text  
  createdAt  DateTime @default(now())
}


model Product {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  image       String
  page        ProductPage
  createdAt   DateTime @default(now())
}

enum ProductPage {
  DIEMANUFACTURING
  EXTRUDEDPRODUCTS
  FABRICATION
  NEWALLOY
}
