# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# JWT signing secret. REQUIRED — the app refuses to start without it.
# Generate a fresh one with:  openssl rand -base64 48
# Never commit the real value; rotating it invalidates all existing sessions.
AUTH_SECRET=""

# Where uploaded images and catalogue PDFs are written. Must stay OUTSIDE public/.
# Laptops use storage/uploads/local. On the production server leave this
# unset: it defaults to storage/uploads/production. Both are git-ignored.
UPLOAD_DIR="storage/uploads/local"
